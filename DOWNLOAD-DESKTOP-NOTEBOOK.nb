(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["\<\
Seminar of Wolfram Language programming and machine learning for physics, \
mathematics, and engineering at Zewail City of Science and Technology\
\>", "Title",
 CellChangeTimes->{
  4.0035030942077885`*^9},ExpressionUUID->"2d7274b5-57e5-f54d-bfc4-\
16900bacee69"],

Cell[TextData[{
 "by ",
 ButtonBox["Akram Masoud",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/u/akram2007omar/"], None},
  ButtonNote->"https://community.wolfram.com/u/akram2007omar/"]
}], "Author",
 CellChangeTimes->{{4.003503112984049*^9, 
  4.0035031319154396`*^9}},ExpressionUUID->"1998e2ee-48af-c54a-b6d5-\
464b117255ba"],

Cell[TextData[{
 "On November 11, 2026, I had the pleasure of delivering \
\[OpenCurlyDoubleQuote]Wolfram Language Programming and Machine Learning for \
Physics, Mathematics, and Engineering\[CloseCurlyDoubleQuote] at the ",
 ButtonBox["Center for Fundamental Physics (CFP)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.zewailcity.edu.eg/center/6"], None},
  ButtonNote->"https://www.zewailcity.edu.eg/center/6"],
 ", ",
 ButtonBox["Zewail City of Science and Technology",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.zewailcity.edu.eg/"], None},
  ButtonNote->"https://www.zewailcity.edu.eg/"],
 ". The seminar provided a welcoming setting for exploring how ",
 ButtonBox["Wolfram Mathematica",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/mathematica/"], None},
  ButtonNote->"https://www.wolfram.com/mathematica/"],
 " can support scientific learning and research through programming, symbolic \
and numerical computation, visualization, and machine learning. This abridged \
version of the seminar notebook presents the introductory demonstrations, \
applications across scientific disciplines, and a structured learning \
roadmap, with suggested timelines and pathways toward official ",
 ButtonBox["Wolfram certifications",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/certifications/"], None},
  ButtonNote->"https://www.wolfram.com/wolfram-u/certifications/"],
 ". The machine learning demonstrations, including the introduction to \
physics-informed neural networks (PINNs), have been omitted from this version \
to meet the upload size limit. The complete notebook is available ",
 ButtonBox["here",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.dropbox.com/scl/fi/ajmp40ppzww8azsz1f76f/A-Wolfram-\
Mathematica-Seminar-at-Zewail-City-of-Science-and-Technology.nb?rlkey=\
bie2dx5exm1rb5quuyfa5e0it&dl=0"], None},
  ButtonNote->
   "https://www.dropbox.com/scl/fi/ajmp40ppzww8azsz1f76f/A-Wolfram-\
Mathematica-Seminar-at-Zewail-City-of-Science-and-Technology.nb?rlkey=\
bie2dx5exm1rb5quuyfa5e0it&dl=0"],
 ". I presented the seminar as a ",
 ButtonBox["Wolfram Certified Instructor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/instructors/akram-masoud.html"], 
    None},
  ButtonNote->
   "https://www.wolfram.com/wolfram-u/instructors/akram-masoud.html"],
 " in ",
 ButtonBox["Mathematica",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/mathematica/"], None},
  ButtonNote->"https://www.wolfram.com/mathematica/"],
 ", a ",
 ButtonBox["Wolfram Student Ambassador",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/company/careers/ambassador/"], None},
  ButtonNote->"https://www.wolfram.com/company/careers/ambassador/"],
 ", and an Educational Technology Engineer. Through my website, ",
 ButtonBox["SciLearnix",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scilearnix.com/"], None},
  ButtonNote->"https://scilearnix.com/"],
 ", I work on ",
 ButtonBox["Mathematica",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/mathematica/"], None},
  ButtonNote->"https://www.wolfram.com/mathematica/"],
 " programming and machine learning, scientific writing, and mathematics. I \
am also a PhD student in Mathematical Astronomy at the ",
 ButtonBox["Department of Astronomy, Space Science and Meteorology",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scicu.net/departments/astronomy"], None},
  ButtonNote->"https://scicu.net/departments/astronomy"],
 ", ",
 ButtonBox["Faculty of Science",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scicu.net/"], None},
  ButtonNote->"https://scicu.net/"],
 ", ",
 ButtonBox["Cairo University",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://cu.edu.eg/Home"], None},
  ButtonNote->"https://cu.edu.eg/Home"],
 ", under the supervision of Dr. ",
 ButtonBox["Walid Rahoma",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scholar.google.com/citations?user=dCKvklYAAAAJ&hl=en"], None},
  ButtonNote->"https://scholar.google.com/citations?user=dCKvklYAAAAJ&hl=en"],
 ". My sincere thanks go to Dr. ",
 ButtonBox["Tahia F. Dabash",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scholar.google.com/citations?user=_g31pc0AAAAJ&hl=en"], None},
  ButtonNote->"https://scholar.google.com/citations?user=_g31pc0AAAAJ&hl=en"],
 " and Mr. ",
 ButtonBox["Hussein Elkhaldy",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.linkedin.com/in/ikhaldy-hussein-khaled-iphone-06829114a/\
"], None},
  ButtonNote->
   "https://www.linkedin.com/in/ikhaldy-hussein-khaled-iphone-06829114a/"],
 " for proposing the initiative, and to Dr. ",
 ButtonBox["Ahmed Ayad",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scholar.google.com/citations?user=qJtOgB4AAAAJ&hl=en"], None},
  ButtonNote->"https://scholar.google.com/citations?user=qJtOgB4AAAAJ&hl=en"],
 " and Dr. ",
 ButtonBox["Shaaban Khalil",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://scholar.google.com/citations?user=7T5M4SkAAAAJ&hl=en"], None},
  ButtonNote->"https://scholar.google.com/citations?user=7T5M4SkAAAAJ&hl=en"],
 " for organizing and hosting the seminar. I am grateful to the ",
 ButtonBox["CFP",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.zewailcity.edu.eg/center/6"], None},
  ButtonNote->"https://www.zewailcity.edu.eg/center/6"],
 " and ",
 ButtonBox["Zewail City",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.zewailcity.edu.eg/"], None},
  ButtonNote->"https://www.zewailcity.edu.eg/"],
 " for the opportunity, to ",
 ButtonBox["Wolfram",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/"], None},
  ButtonNote->"https://www.wolfram.com/"],
 " for supporting my work as a ",
 ButtonBox["Student Ambassador",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/company/careers/ambassador/"], None},
  ButtonNote->"https://www.wolfram.com/company/careers/ambassador/"],
 ", and to everyone who attended and contributed to the discussion."
}], "Abstract",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{
