Cell[CellGroupData[{

Cell["Earth Sciences: Mountains and Terrain", "Subsection",
 CellChangeTimes->{{3.984127724091507*^9, 3.9841277280399914`*^9}, 
   4.003068867108265*^9, 4.003069891002836*^9, {4.00307005712397*^9, 
   4.0030700581779613`*^9}},ExpressionUUID->"555e8074-34db-ea49-b305-\
1dcbeb36e65f"],

Cell["\<\
Find nearby mountains, retrieve geographic information, and visualize terrain \
elevation in three dimensions.\
\>", "Text",
 CellChangeTimes->{
  4.0032291481940746`*^9},ExpressionUUID->"84f58ce6-3e42-714c-a69e-\
8cde61d728c3"],

Cell["Find the three mountains nearest to your current location:", "CodeText",
 CellChangeTimes->{{4.003085028242033*^9, 4.003085032285452*^9}, 
   4.0030851580051994`*^9},ExpressionUUID->"ebaa6f7a-489b-4e45-bb12-\
e16b4b878ae4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mounts", "=", 
  RowBox[{"GeoNearest", "[", 
   RowBox[{"\"\<Mountain\>\"", ",", "Here", ",", "3"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.98412809271035*^9, 3.9841280927113495`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"fb8ae5dc-a6f1-5045-884e-2d76b35e92cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"\"Mount Sinai\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Mountain\"", ",", "\"MountSinai\""}], "]"}], 
     "\"Entity[\\\"Mountain\\\", \\\"MountSinai\\\"]\"", "\"mountain\""},
    "Entity"], ",", 
   TemplateBox[{"\"Mount Catherine\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Mountain\"", ",", "\"MountCatherine::f2jqh\""}], "]"}], 
     "\"Entity[\\\"Mountain\\\", \\\"MountCatherine::f2jqh\\\"]\"", 
     "\"mountain\""},
    "Entity"], ",", 
   TemplateBox[{"\"Ra's Khar\:016bf\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Mountain\"", ",", "\"RasKharuf\""}], "]"}], 
     "\"Entity[\\\"Mountain\\\", \\\"RasKharuf\\\"]\"", "\"mountain\""},
    "Entity"]}], "}"}]], "Output",
 CellChangeTimes->{4.003414913848858*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"a70ef280-365e-5b4b-8a41-7efd3474902b"]
}, Open  ]],

Cell["Display a geographic disk centered on the second mountain:", "CodeText",
 CellChangeTimes->{{4.003085028242033*^9, 4.003085032285452*^9}, 
   4.0030851652132626`*^9, 
   4.0032496123700294`*^9},ExpressionUUID->"2f2ef65f-e605-c74b-889b-\
cf1b32d6d632"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"disk", "=", 
  RowBox[{"GeoGraphics", "[", 
