Cell[CellGroupData[{

Cell["Neural Networks in the Wolfram Language", "ItemNumbered",
 CellChangeTimes->{
  3.983447138579817*^9, 4.00315915698386*^9, 4.0031595036955795`*^9, 
   4.0031598770826435`*^9, 4.0031599195634804`*^9, 4.003160304731966*^9, 
   4.0031634538376274`*^9, {4.003164247955822*^9, 4.003164259974251*^9}, 
   4.00316431086425*^9, 4.0031647125603848`*^9, {4.0031654541050377`*^9, 
   4.0031654655809956`*^9}},
 FontWeight->"Bold",ExpressionUUID->"75521cef-edf4-cb44-b6a5-0de9c010bf70"],

Cell[TextData[{
 "I recommend ",
 ButtonBox["Neural Networks in the Wolfram Language",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
NeuralNetworksOverview.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/NeuralNetworksOverview.\
html"],
 ", a written tutorial in the Documentation Center covering network \
construction, training, and evaluation, with practical examples in \
classification, regression, computer vision, language, and audio."
}], "ItemParagraph",
 CellChangeTimes->{
  4.0031589760535126`*^9, 4.0031601116362915`*^9, {4.003160163374195*^9, 
   4.0031601633751526`*^9}, {4.003161756598482*^9, 4.0031618232583656`*^9}, {
   4.00316206446673*^9, 4.003162088960989*^9}, 4.0031634809588776`*^9, {
   4.0031636645048084`*^9, 4.003163680215233*^9}, {4.003163927179184*^9, 
   4.0031639474147854`*^9}, {4.003164396429533*^9, 4.0031644821988487`*^9}, {
   4.0031645127059593`*^9, 4.003164566990761*^9}, {4.0031648029506855`*^9, 
   4.003164827922556*^9}, 4.003165700233961*^9, {4.0031661202805977`*^9, 
   4.003166143673744*^9}},
 FontColor->GrayLevel[
  0],ExpressionUUID->"64cd67e3-fb97-c044-abbf-2cc892c715a6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Training Neural Networks with Regularization", "ItemNumbered",
 CellChangeTimes->{
  3.983447138579817*^9, 4.00315915698386*^9, 4.0031595036955795`*^9, 
   4.0031598770826435`*^9, 4.0031599195634804`*^9, 4.003160304731966*^9, 
   4.0031634538376274`*^9, {4.003164247955822*^9, 4.003164259974251*^9}, 
   4.00316431086425*^9, 4.0031647125603848`*^9, {4.0031654541050377`*^9, 
   4.0031654827026367`*^9}},
 FontWeight->"Bold",ExpressionUUID->"0e0aee75-1c5a-5b49-863d-9cdbc80f7ff4"],

Cell[TextData[{
 "I recommend ",
 ButtonBox["Training Neural Networks with Regularization",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
NeuralNetworksRegularization.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
NeuralNetworksRegularization.html"],
 ", a written tutorial in the Documentation Center explaining overfitting and \
techniques for improving generalization, including validation sets, early \
stopping, weight decay, and dropout."
}], "ItemParagraph",
 CellChangeTimes->{
  4.0031589760535126`*^9, 4.0031601116362915`*^9, {4.003160163374195*^9, 
