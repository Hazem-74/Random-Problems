Cell[TextData[{
 "Enter requests in plain English to perform calculations, solve equations, \
create plots, and explore real-world information. At the start of a new input \
cell, press ",
 Cell[BoxData[
  FormBox["=", TraditionalForm]],ExpressionUUID->
  "20baee85-5361-6842-ab40-dca15d7eef4a"],
 ", then type your request."
}], "Text",
