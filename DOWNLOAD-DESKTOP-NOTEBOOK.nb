Cell["Vary the amplitude interactively:", "CodeText",
 CellChangeTimes->{{4.0031501531669292`*^9, 4.003150160751152*^9}, 
   4.003150452860422*^9},ExpressionUUID->"fa89ec43-441d-c84a-b994-\
2a56feeee4c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"3", " ", "t"}], "+", 
        FractionBox["\[Pi]", "2"]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "10"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "1", ",", "10"}], "}"}], ",", 
   RowBox[{"ControlPlacement", "->", "Top"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9841291991983967`*^9, 3.984129199199396*^9}, {
  3.984131882579649*^9, 3.984131931383665*^9}, {3.984132242076172*^9, 
