c9c61d757481"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CloudPublish", "[", 
  RowBox[{"FormPage", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", "->", "\"\<Integer\>\""}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"#x", ">", "0"}], ",", 
       RowBox[{"Prime", "[", "#x", "]"}], 
       ",", "\"\<Enter a positive integer.\>\""}], "]"}], "&"}], ",", 
    RowBox[{"PageTheme", "->", "\"\<Black\>\""}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.0032563011484184`*^9, 4.0032563011484184`*^9}},
