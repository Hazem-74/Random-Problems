Cell["\<\
Find the shortest tour through Egypt\[CloseCurlyQuote]s governorates and \
display its total distance and the governorate names in visitation order:\
\>", "CodeText",
 CellChangeTimes->{{4.0030853610498924`*^9, 4.003085364931177*^9}, 
   4.003085519175785*^9, 
   4.0033711419851494`*^9},ExpressionUUID->"1bafaee2-3445-0f41-a672-\
2f34ca42ee23"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tour", "=", 
   RowBox[{"FindShortestTour", "[", "states", "]"}]}], ";"}], "\n", 
 RowBox[{"tour", "[", 
  RowBox[{"[", "1", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"StringReplace", "[", 
  RowBox[{
   RowBox[{"EntityValue", "[", 
    RowBox[{
     RowBox[{"states", "[", 
      RowBox[{"[", 
       RowBox[{"tour", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", "\"\<Name\>\""}], 
    "]"}], ",", 
   RowBox[{
    RowBox[{"\"\<, Egypt\>\"", "~~", "EndOfString"}], "->", "\"\<\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9841288254052296`*^9, 3.984128825406246*^9}, {
   3.9841313822214985`*^9, 3.984131384711878*^9}, {4.003371052028099*^9, 
   4.003371091757168*^9}, 4.003371200414982*^9},
 CellLabel->"In[62]:=",ExpressionUUID->"60d57bbf-4822-e545-af58-09f2ba5f7c8b"],

