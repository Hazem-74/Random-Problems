Cell[CellGroupData[{

Cell["Wolfram Entities", "Subsection",
 CellChangeTimes->{
  4.0030452496866055`*^9},ExpressionUUID->"a21e6b28-34bd-da47-88b1-\
424028a901ea"],

Cell[TextData[{
 "Entities represent real-world objects, such as countries, chemicals, and \
species, as symbolic expressions with accessible properties. Use Ctrl ",
 Cell[BoxData[
  FormBox["+", TraditionalForm]],ExpressionUUID->
  "1a283cc2-4615-4542-80f5-0f3084b374ee"],
 " ",
 Cell[BoxData[
  FormBox["\"\<=\>\"", TraditionalForm]],ExpressionUUID->
  "8c5db403-0134-a845-9483-f41a169104e4"],
 " to enter an entity through natural language, or write it directly in ",
 ButtonBox["Wolfram Language",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/language/"], None},
  ButtonNote->"https://www.wolfram.com/language/"],
 "."
}], "Text",
 CellChangeTimes->{
  4.0030452593720665`*^9, 4.0030461888784027`*^9, 4.003046239608015*^9, 
   4.0032157832529335`*^9, {4.0032225456263027`*^9, 4.0032225605051575`*^9}, {
   4.00323089036158*^9, 
   4.003230909322994*^9}},ExpressionUUID->"96ff57ab-0d58-ca42-b980-\
7e0254a05aa7"],

