Cell[CellGroupData[{

Cell["Physics: Electric Fields", "Subsection",
 CellChangeTimes->{{4.0030697972264633`*^9, 4.003069798815214*^9}, {
  4.0030699107321033`*^9, 4.0030699150617924`*^9}, {4.003070101811964*^9, 
  4.0030701034851665`*^9}},ExpressionUUID->"03db0f07-1644-3d4d-b61c-\
ef86b0fc8952"],

Cell[TextData[{
 "Electric charge is a physical property of matter that produces electric \
forces. It can be positive or negative and is measured in coulombs (C). The \
electric field at a point is the electric force per unit positive test \
charge: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["E", "\[RightVector]"], "=", 
    RowBox[{
     OverscriptBox["F", "\[RightVector]"], "/", 
     SubscriptBox["q", "Test"]}]}], TraditionalForm]],ExpressionUUID->
  "42bfa71a-69c3-364b-ab38-ea0474c63f14"],
 ". Here, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["E", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "b060803a-028d-ba4c-985b-e679d2c44250"],
 " is the electric field in newtons per coulomb (N/C), ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["F", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2f232054-6204-3c48-87f0-4a44df322a43"],
 " is the electric force on the test charge in newtons (N), and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "Test"], TraditionalForm]],ExpressionUUID->
  "a391fee8-4f71-5241-9d4f-8b698150d22e"],
 " is a small positive test charge in coulombs (C). For a point charge in \
vacuum, the electric field is:"
}], "Text",
 CellChangeTimes->{{4.0030857091997967`*^9, 4.0030857320848713`*^9}, 
   4.003085773333584*^9, {4.0030859367954216`*^9, 4.0030859477478504`*^9}, {
   4.003086035671772*^9, 4.0030860369438057`*^9}, {4.003086504634754*^9, 
   4.003086529589855*^9}, {4.003087096772167*^9, 4.0030872180539665`*^9}, {
   4.0030874669121*^9, 4.003087503315111*^9}, {4.0030876976246777`*^9, 
   4.003087698906473*^9}},ExpressionUUID->"9fab34cb-5427-7d43-9afc-\
eb719131733a"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    FormBox[
     OverscriptBox["E", "\[RightVector]"],
     TraditionalForm], 
    RowBox[{"(", 
     FormBox[
      OverscriptBox["r", "\[RightVector]"],
      TraditionalForm], ")"}]}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "\[Pi]", " ", 
      SubscriptBox["\[CurlyEpsilon]", "0"]}]], " ", 
    FractionBox[
     StyleBox["q",
      FontSlant->"Italic"], 
     SuperscriptBox[
      StyleBox["r",
       FontSlant->"Italic"], "2"]], " ", 
    OverscriptBox[
     StyleBox["r",
      FontSlant->"Italic"], "^"]}]}],
  FontWeight->"Bold"]], "DisplayFormula",
 CellChangeTimes->{
  4.003085806096979*^9, 4.003085856029543*^9, {4.003085975815916*^9, 
   4.0030859877788734`*^9}, {4.003087288028631*^9, 4.003087373800001*^9}, 
   4.0030874111750393`*^9, {4.003087449158718*^9, 4.003087450572386*^9}, {
   4.003087543827797*^9, 4.0030875906012344`*^9}},
 TextAlignment->Center,
 FontSize->17,ExpressionUUID->"7ec79b71-edee-f64f-8278-a42030e88695"],

Cell[TextData[{
 "Here, ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "51bd7102-57cc-b245-9966-40c5d7ec116d"],
 " is the source charge in coulombs (C), and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", "0"], TraditionalForm]],ExpressionUUID->
  "e1b2678b-baed-5c4b-9b20-b87f4cc54689"],
 " is the vacuum permittivity. The scalar ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "39fd8481-16a2-8641-b636-3cb9b3bd431c"],
 " is the distance from the source charge to the observation point, measured \
in meters (m). The unit vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "^"], "=", 
    RowBox[{
     OverscriptBox["r", "\[RightVector]"], "/", "r"}]}], TraditionalForm]],
  ExpressionUUID->"aff9c2bd-9c67-4b48-b4a0-f2072fb1e7b1"],
 " points in this direction, where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["r", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "80245feb-619f-8145-8647-c82d457126ee"],
 " is the displacement vector from the source charge to the observation point \
and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     OverscriptBox["r", "\[RightVector]"], "|"}], "=", "r"}], 
   TraditionalForm]],ExpressionUUID->"1d813dfa-3b44-5c47-bc94-00579780dd35"],
 ". The following plots use relative charge strengths and omit the common \
positive constant ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"4", "\[Pi]", " ", "\[CurlyEpsilon]\:2080"}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"81619ad0-aa5a-2847-8bc8-99d3ab4336ea"],
 ", which does not affect field direction."
}], "Text",
 CellChangeTimes->{
  4.003085927054001*^9, 4.0030860313555965`*^9, 4.0030865396053543`*^9, 
   4.0030876462464504`*^9, {4.00308770747987*^9, 4.0030877097234287`*^9}, {
   4.003087826544445*^9, 4.003087941670702*^9}, {4.0032564474605045`*^9, 
   4.003256480581068*^9}},ExpressionUUID->"62bdc7a6-744a-5d4d-8cb3-\
9a9f9c19cd37"],

Cell["\<\
Plot the electric fields of positive and negative point charges, marking the \
positive charge in red and the negative charge in blue:\
\>", "CodeText",
 CellChangeTimes->{
  4.0030863056978073`*^9, {4.0030863641608105`*^9, 4.0030863654202404`*^9}, 
   4.0030865515037518`*^9, 
   4.0031396733410378`*^9},ExpressionUUID->"fde243bf-8caf-1d4a-b826-\
b7eb8fe09c00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VectorPlot", "[", 
      RowBox[{
       RowBox[{"#", " ", 
        FractionBox[
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}], 
          RowBox[{"3", "/", "2"}]]]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", 
           StyleBox[
           "\"Options\"", "IconizedCustomName", StripOnInput -> False], 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["Sequence", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["5", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["960", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
           Dynamic[Typeset`open]},
          "IconizedObject"]],
        Sequence[
        VectorScaling -> Automatic, Axes -> True, AxesLabel -> {"x", "y"}, 
         Epilog -> {
           If[# > 0, Red, Blue], 
           PointSize[0.03], 
           Point[{0, 0}]}, ImageSize -> 400],
        SelectWithContents->True,
        Selectable->False]}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\"\<                 \>\""}], 
  "]"}]], "Input",
