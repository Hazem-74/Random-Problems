Cell["Create a collage of African country flags:", "CodeText",
 CellChangeTimes->{{4.0030848861917496`*^9, 4.0030848919319916`*^9}, 
   4.003085013651964*^9},ExpressionUUID->"45bf47a0-b3cf-7b4b-9e4c-\
28c0fd18904a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ImageCollage", "@", 
  RowBox[{"EntityValue", "[", 
   RowBox[{
    RowBox[{
     TemplateBox[{"\"Africa\"", 
       RowBox[{"Entity", "[", 
         RowBox[{"\"GeographicRegion\"", ",", "\"Africa\""}], "]"}], 
       "\"Entity[\\\"GeographicRegion\\\", \\\"Africa\\\"]\"", 
       "\"geographic region\""},
      "Entity"], "[", 
     TemplateBox[{"\"countries\"", 
       RowBox[{"EntityProperty", "[", 
         RowBox[{"\"GeographicRegion\"", ",", "\"Countries\""}], "]"}], 
       "\"EntityProperty[\\\"GeographicRegion\\\", \\\"Countries\\\"]\""},
      "EntityProperty"], "]"}], ",", 
    TemplateBox[{"\"flag\"", 
      RowBox[{"EntityProperty", "[", 
        RowBox[{"\"Country\"", ",", "\"Flag\""}], "]"}], 
      "\"EntityProperty[\\\"Country\\\", \\\"Flag\\\"]\""},
     "EntityProperty"]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.984150082792839*^9, {3.984150116700987*^9, 3.9841501201079865`*^9}, {
   4.003249394488558*^9, 4.0032493991943913`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"62b4b04e-be36-3f4d-b9c4-7d061edcc6a4"],

