Cell[CellGroupData[{

Cell["Sources and Acknowledgments", "Section",
 CellChangeTimes->{{4.003041569858797*^9, 4.0030415810139637`*^9}, 
   4.003042305276327*^9, {4.0030812230447025`*^9, 4.0030812235387173`*^9}, 
   4.0030845337057896`*^9, {4.0030884164428844`*^9, 4.0030884172280807`*^9}, {
   4.0032312754827614`*^9, 4.003231278287098*^9}, 
   4.003231501965378*^9},ExpressionUUID->"91450a3b-9e9d-0a4e-b74f-\
fe1bd6562f2f"],

Cell[TextData[{
 "Most of the material in this notebook draws on ",
 ButtonBox["Wolfram",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/"], None},
  ButtonNote->"https://www.wolfram.com/"],
 " resources. Some explanations, code examples, and demonstrations closely \
follow their original sources, particularly the ",
 ButtonBox["Wolfram Language Documentation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/"], None},
  ButtonNote->"https://reference.wolfram.com/language/"],
 ", Etienne Bernard\[CloseCurlyQuote]s ",
 ButtonBox["Introduction to Machine Learning",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/language/introduction-machine-learning/"], 
    None},
  ButtonNote->
   "https://www.wolfram.com/language/introduction-machine-learning/"],
 ", and the ",
 ButtonBox["Introduction to Wolfram Tech",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/courses/wolfram-language/quick-\
start-wolfram-tech-wl101/"], None},
  ButtonNote->
   "https://www.wolfram.com/wolfram-u/courses/wolfram-language/quick-start-\
wolfram-tech-wl101/"],
 " course. Additional material draws on ",
 ButtonBox["Wolfram U",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/"], None},
  ButtonNote->"https://www.wolfram.com/wolfram-u/"],
 " and other ",
 ButtonBox["Wolfram",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/"], None},
  ButtonNote->"https://www.wolfram.com/"],
 " websites and resources. I also thank Luis Medrano Navarro, Luis Martin \
Moreno, and Sergio G. Rodrigo for their paper, \[OpenCurlyDoubleQuote]",
 ButtonBox["Solving differential equations with Deep Learning: a beginner's \
guide",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2307.11237"], None},
  ButtonNote->"https://arxiv.org/abs/2307.11237"],
 ",\[CloseCurlyDoubleQuote] which helped me learn the fundamentals of \
physics-informed neural networks (PINNs). These sources are acknowledged here \
and recommended for further study."
}], "Text",
 CellChangeTimes->{{4.0034155748780346`*^9, 4.0034156356543636`*^9}, {
  4.003415709990999*^9, 
  4.0034157099930744`*^9}},ExpressionUUID->"ea18373b-fca6-d54f-b027-\
0ef0b4c8cb8e"]
}, Open  ]],

