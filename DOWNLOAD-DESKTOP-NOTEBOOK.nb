Cell[CellGroupData[{

Cell["Wolfram Notebook Assistant", "Section",
 CellChangeTimes->{
  4.003047552006218*^9, {4.003084445441883*^9, 4.0030844459494267`*^9}, 
   4.0034994749769096`*^9},ExpressionUUID->"e162eb7e-386d-7c4f-acb5-\
3ec8d6f74b35"],

Cell[TextData[{
 ButtonBox["Wolfram Notebook Assistant",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/NotebookAssistant.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/NotebookAssistant.html"],
 " is an AI assistant that supports tasks ranging from answering simple \
coding questions and correcting errors to developing complete notebook \
projects from scratch through conversation. We will explore its usefulness \
across three tasks of increasing complexity: generating a 3D function plot, \
diagnosing and correcting faulty code, and creating a complete project. For \
each task, we will use one or more prompts, deliberately providing ",
 StyleBox["limited details",
  FontWeight->"Bold"],
 ", ",
 StyleBox["imperfect English",
  FontWeight->"Bold"],
 ", and ",
 StyleBox["occasional typos",
  FontWeight->"Bold"],
 ". We will run and review the results to assess how well the assistant meets \
our needs with minimal prompting effort and programming experience."
}], "Text",
 CellChangeTimes->{
  4.003052553822113*^9, {4.003052628074692*^9, 4.0030526323614044`*^9}, {
   4.003052684314049*^9, 4.0030526844858494`*^9}, {4.003052932297617*^9, 
   4.0030529786320457`*^9}, {4.003053009889803*^9, 4.003053010784296*^9}, {
   4.0030848034278984`*^9, 4.003084804174677*^9}, {4.0032216468719864`*^9, 
   4.003221646872986*^9}, {4.003222390702055*^9, 
   4.0032224130883904`*^9}},ExpressionUUID->"8a6ecde7-89ea-0740-a25f-\
c4e64dad63dc"],

Cell[CellGroupData[{

Cell["3D Function Plotting", "Subsection",
 CellChangeTimes->{4.003053056657238*^9, 
  4.003054470144987*^9},ExpressionUUID->"fc97b688-53a0-e84e-9fb3-\
e5913df3de0f"],

Cell[TextData[{
 "In this task, you will ask the assistant to generate code for a 3D plot of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"sin", "(", 
    StyleBox["xy",
     FontSlant->"Italic"], ")"}], TraditionalForm]],ExpressionUUID->
  "394d1948-b574-f648-b989-7092ffe5abeb"],
 ". To test how it handles informal wording and limited detail, use this \
prompt: \[OpenCurlyDoubleQuote]",
 StyleBox["i want 3d plot of sin(",
  FontWeight->"Bold"],
 StyleBox["xy",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[") from ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "5"}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"2c0b3f0b-a585-df42-a4be-621c8373c32f"],
 StyleBox[" to 5 for both ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"0fd0d1f9-f162-cb45-acf6-f9a4dc580b5d"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"6b5f4363-3f89-3f48-aed3-e685e91338d4"],
 StyleBox[". nice colours and axis names. give me the code",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{
  4.003053170767935*^9, {4.0032238916432877`*^9, 4.0032239172201023`*^9}, {
   4.0032239619209995`*^9, 
   4.003223971753439*^9}},ExpressionUUID->"d4fb8962-a2c9-f649-99b8-\
38eacec999f2"],

Cell["Try the assistant\[CloseCurlyQuote]s first suggestion:", "CodeText",
 CellChangeTimes->{
  4.0030534477406654`*^9},ExpressionUUID->"b424cef9-f8d4-8642-989b-\
87d7a48938e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"x", " ", "y"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<sin(x y)\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<sin(x y)\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Web\>\""}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"0fc72916-318e-be40-8148-cf33cc1c6b65"],

