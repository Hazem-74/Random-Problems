Cell[TextData[{
 "My recommended starting point is Stephen Wolfram\[CloseCurlyQuote]s An \
Elementary Introduction to the ",
 ButtonBox["Wolfram Language",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/language/"], None},
  ButtonNote->"https://www.wolfram.com/language/"],
 ", available as both a ",
 ButtonBox["book",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/language/elementary-introduction/3rd-ed/"], 
    None},
  ButtonNote->
   "https://www.wolfram.com/language/elementary-introduction/3rd-ed/"],
 " and an ",
 ButtonBox["interactive course",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/courses/wolfram-language/an-\
elementary-introduction-to-the-wolfram-language/"], None},
  ButtonNote->
   "https://www.wolfram.com/wolfram-u/courses/wolfram-language/an-elementary-\
introduction-to-the-wolfram-language/"],
 ". Use the book as a reference and follow the course for guided learning and \
hands-on practice."
}], "ItemParagraph",
 CellChangeTimes->{
  4.0031589760535126`*^9, {4.003163333158844*^9, 4.003163374488123*^9}, 
   4.00322260288912*^9},
 FontColor->GrayLevel[
  0],ExpressionUUID->"64a7beaa-351e-7f4f-8420-93eb63ac692f"],

