Cell[TextData[{
 "The ",
 ButtonBox["Traveling Salesman Problem",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Travelling_salesman_problem"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Travelling_salesman_problem"],
 " seeks the shortest route that visits each location once and returns to the \
starting point."
}], "Text",
 CellChangeTimes->{{4.0030854370343437`*^9, 4.0030854526689034`*^9}, {
  4.0032167177070236`*^9, 
