   4.0031692146006126`*^9}, {4.0031692781167984`*^9, 4.003169295767687*^9}},
 FontColor->GrayLevel[
  0],ExpressionUUID->"2e0a96e9-f7ab-b749-af5c-f5f954d2b147"]
}, Open  ]],

