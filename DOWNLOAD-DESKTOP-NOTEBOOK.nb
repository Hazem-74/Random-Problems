        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}], "2"]}], ")"}], 
      RowBox[{"3", "/", "2"}]]], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "-", 
      RowBox[{"{", 
