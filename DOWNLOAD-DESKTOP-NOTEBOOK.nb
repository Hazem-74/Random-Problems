Cell[TextData[{
 "Plot the combined electric field of a positive charge at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "90dadce0-fb7b-4946-b7ff-e761e7f23119"],
 ", marked in red, and an equal-magnitude negative charge at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "1"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "5f1487ef-0d34-aa4b-afbc-c23e37490e85"],
 ", marked in blue:"
}], "CodeText",
